# =============================================================================
# PasarguardBot — Environment Configuration
# Telegram uses the HTTP Bot API only. No API_ID/API_HASH or MTProto session.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
# Get BOT_TOKEN from @BotFather. Keep this secret and never commit it.
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Comma-separated Telegram user IDs with admin access.
ADMIN_ID=PASTE_NUMERIC_TELEGRAM_ID_HERE

# Branding
# BOT_TAG=PRIMEVPN
# ADMIN_ID_TAG=
# CHANNEL_ID_TAG=
# TUTORIAL_HELP_LINKS=
# DISABLE_UPTIME_BUTTONS=true
# LINK_UPTIME_BUTTONS=https://status.google.ir

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
SQLALCHEMY_DATABASE_URL=mysql+asyncmy://pasarguardbot:PASSWORD@localhost:3306/pasarguardbot
# SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///./pasarguard.db

# -----------------------------------------------------------------------------
# FastAPI & Logging
# -----------------------------------------------------------------------------
# FASTAPI_PORT=6160
# LOG_CHANNEL=-1001772624536
# LOG_LEVEL=INFO
# LOG_DIR=./logs
# LOG_TO_FILE=true
# LOG_USE_RICH=false
# LOG_MIDDLEWARE_DEBUG=false
# LOG_HANDLER_EVENTS=false

# -----------------------------------------------------------------------------
# Integrations / payment networks
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=
# TRX_TESTNET_MODE=
# TON_TESTNET_MODE=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6161
# REDIS_NAMESPACE_PREFIX=pasarguardbot:mainbot
# STATE_TTL_SECONDS=86400
# LOCK_TTL_SECONDS=300
# CALLBACK_TTL_SECONDS=3600

# Comma-separated Telegram module paths to disable at startup.
# DISABLED_TELEGRAM_MODULES=

# MariaDB / deployment variables are supplied by Railway or the deployment
# environment and are intentionally not committed here.
